# ============================================
# Hy3 研究助手 — 环境变量配置模板
# ============================================
# 使用方式：
#   1. 复制此文件为 .env ：  cp .env.example .env
#   2. 编辑 .env 填入你的密钥和可选参数
#   3. 启动服务即可自动加载
#
# ⚠️  警告：.env 包含敏感信息，切勿提交到 Git 仓库！
# ============================================

# ---------- 必填项 ----------

# Hy3 API 密钥（腾讯混元大模型，必填）
# 获取方式请访问腾讯混元开放平台
HY3_API_KEY=your-api-key-here

# ---------- API 配置 ----------

# Hy3 API 端点地址（可选，默认使用腾讯云）
# 如使用自建代理或私有部署，修改此地址
# HY3_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1

# 使用的模型名称（可选，默认 hunyuan-pro）
# 可选: hunyuan-pro | hunyuan-lite | hunyuan-standard 等
# HY3_MODEL=hunyuan-pro

# API 请求超时时间，单位秒（可选，默认 120）
# 深度研究等长任务建议保持此值
# HY3_TIMEOUT=120

# ---------- 服务配置 ----------

# 服务器监听地址（可选，默认 0.0.0.0，即所有网卡）
# 仅本机访问可改为 127.0.0.1
# HOST=0.0.0.0

# 服务器端口（可选，默认 8000）
# PORT=8000

# ---------- 功能开关 ----------

# 启用网页搜索能力（可选，默认 true）
# 关闭后深度研究将跳过搜索步骤
# ENABLE_SEARCH=true

# 最大搜索结果数（可选，默认 5）
# MAX_SEARCH_RESULTS=5

# ---------- MCP Server 配置（仅当使用 MCP Server 时生效）----------

# MCP Server 日志级别（可选，默认 info）
# 可选: debug | info | warning | error
# MCP_LOG_LEVEL=info

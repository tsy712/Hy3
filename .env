# ===========================================
# Hy3 Research Assistant 配置文件
# ===========================================
# 复制此文件为 .env 并填入实际值

# Hy3 API 密钥（必填）
# 获取地址: https://hunyuan.cloud.tencent.com
HY3_API_KEY=your_api_key_here

# API 端点（通常无需修改）
HY3_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1

# 模型名称
# 可选: hunyuan-pro, hunyuan-lite, hunyuan-standard
HY3_MODEL=hunyuan-pro

# Web 服务配置
HOST=0.0.0.0
PORT=8000
